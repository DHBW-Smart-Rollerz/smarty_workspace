{
  "editor.formatOnSave": true,
  "workbench.colorCustomizations": {
    "tab.activeBorder": "#ffffff",
    "tab.activeBackground": "#373737"
  },
  // Python: Ruff formats the code and sorts the imports on save (configured in ruff.toml)
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },
  "python.defaultInterpreterPath": "python",
  "python.testing.pytestEnabled": true,
  // Static type checking with Pylance/Pyright (same mode as `make test`)
  "python.analysis.typeCheckingMode": "standard",
  // ROS and the workspace packages are found automatically if VS Code is started
  // from a terminal (e.g. `code ~/smarty_workspace`), because the terminal has ROS sourced.
  "python.analysis.extraPaths": [
    "/opt/ros/jazzy/lib/python3.12/site-packages",
    "${workspaceFolder}/src/smarty_utils"
  ],
  // C/C++: Uncrustify formats the code on save with the ROS 2 code style
  // (same configuration as the ament_uncrustify pre-commit hook)
  "[cpp]": {
    "editor.defaultFormatter": "zachflower.uncrustify",
    "editor.tabSize": 2
  },
  "[c]": {
    "editor.defaultFormatter": "zachflower.uncrustify",
    "editor.tabSize": 2
  },
  "uncrustify.configPath.linux": "/opt/ros/jazzy/lib/python3.12/site-packages/ament_uncrustify/configuration/ament_code_style_0_78.cfg",
  "uncrustify.useReplaceOption": true,
  "C_Cpp.autocompleteAddParentheses": true,
  "[cmake]": {
    "editor.quickSuggestions": {
      "strings": true
    }
  },
  "ROS2.distro": "jazzy",
